<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= item.title %> | Careers at PYX</title><link rel="stylesheet" href="/cms-preview.css"><link rel="stylesheet" href="/layout-refinements.css"></head><body class="content-page"><nav><div class="w nav-inner"><a class="brand" href="/"><img src="<%= site.logo %>" alt="PYX Security Services logo"><span><b><%= site.companyName %></b><small><%= site.strapline %></small></span></a><a class="cta" href="/#careers">All Careers</a></div></nav><main><header class="article-hero"><div class="w"><div class="ey section-kicker">CAREERS AT PYX</div><h1><%= item.title %></h1><p><%= [item.department,item.location_label,item.employment_type].filter(Boolean).join(' · ') %></p></div></header><article class="w article-body"><p class="lead"><%= item.summary %></p><%- item.body %><h2>Apply for this role</h2><form class="career-application" data-job-id="<%= item.id %>" id="careerForm"><input name="name" placeholder="Name *" required><input name="email" placeholder="Email *" type="email" required><input name="mobile" placeholder="Mobile number"><input name="location" placeholder="City / Site"><textarea name="details" placeholder="Briefly tell us about your experience"></textarea><button>Submit Application</button><small class="form-status" role="status">The PYX team will receive your application.</small></form></article></main><footer><div class="w"><%= site.footer %> · <a href="mailto:<%= site.email %>"><%= site.email %></a></div></footer><script src="/site.js"></script></body></html>
